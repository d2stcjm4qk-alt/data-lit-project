import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path
import sys

# ==========================
# 1. Daten laden (Deine Struktur)
# ==========================
def load_data():
    BASE_DIR = Path(__file__).resolve().parent.parent
    data_dir = BASE_DIR / "data" / "processed" / "reduced_uk_dataset"
    
    ger_path = data_dir / "modified_ger.csv"
    uk_path = data_dir / "reduced_uk_dataset.csv"
    # if not ger_path.exists():
    #     print(f"❌ FEHLER: Datei nicht gefunden: {ger_path}")
    #     print(f"   (Gesucht in: {data_dir})")
    #     sys.exit(1)
        
    # if not uk_path.exists():
    #     print(f"❌ FEHLER: Datei nicht gefunden: {uk_path}")
    #     sys.exit(1)

    print(f"✅ Lade Deutschland-Daten: {ger_path.name}")
    df_ger = pd.read_csv(ger_path, low_memory=False)
    
    print(f"✅ Lade UK-Daten: {uk_path.name}")
    df_uk = pd.read_csv(uk_path, low_memory=False)
    
    return df_ger, df_uk

# ==========================
# 2. Plotting: Jahresuhr (Monate)
# ==========================
def plot_seasonal_clock(df_ger, df_uk):
    df_ger['is_severe'] = df_ger['casualty_severity'].isin([1, 2]).astype(int)
    df_uk['is_severe'] = df_uk['collision_severity'].isin([1, 2]).astype(int)

    ger_monthly = df_ger.groupby('month')['is_severe'].mean() * 100
    uk_monthly = df_uk.groupby('month')['is_severe'].mean() * 100
    
    ger_monthly = ger_monthly.reindex(range(1, 13), fill_value=0)
    uk_monthly = uk_monthly.reindex(range(1, 13), fill_value=0)

    # Plot Setup
    N = 12
    theta = np.linspace(0.0, 2 * np.pi, N, endpoint=False)
    width = (2 * np.pi) / N
    months = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez']
    
    # Y-Achsen Limit für Vergleichbarkeit
    max_val = max(ger_monthly.max(), uk_monthly.max()) * 1.1

    fig, ax = plt.subplots(1, 2, subplot_kw={'projection': 'polar'}, figsize=(16, 8))
    
    # DEUTSCHLAND
    ax[0].set_theta_zero_location('N') # Norden = Oben
    ax[0].set_theta_direction(-1)      # Uhrzeigersinn
    ax[0].bar(theta, ger_monthly.values, width=width, bottom=0.0, color='#4c72b0', alpha=0.8, edgecolor='white')
    ax[0].set_xticks(theta)
    ax[0].set_xticklabels(months)
    ax[0].set_ylim(0, max_val)
    ax[0].set_title("DE: Anteil schwerer Unfälle (%)", va='bottom', y=1.08, fontsize=14)

    # UK
    ax[1].set_theta_zero_location('N')
    ax[1].set_theta_direction(-1)
    ax[1].bar(theta, uk_monthly.values, width=width, bottom=0.0, color='#dd8452', alpha=0.8, edgecolor='white')
    ax[1].set_xticks(theta)
    ax[1].set_xticklabels(months)
    ax[1].set_ylim(0, max_val)
    ax[1].set_title("UK: Anteil schwerer Unfälle (%)", va='bottom', y=1.08, fontsize=14)

    plt.tight_layout()
    
    # Speichern im Output-Ordner (optional) oder anzeigen
    plt.show()

# ==========================
# 3. Main
# ==========================
if __name__ == "__main__":
    # Daten laden
    df_ger, df_uk = load_data()
    
    # Plot erstellen
    plot_seasonal_clock(df_ger, df_uk)